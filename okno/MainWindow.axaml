<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="400"
        x:Class="okno.MainWindow"
        Title="Warsztat — Łukasz S"
        Width="640" Height="400">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Margin="24" Background="#1E293B">
            <TextBlock Text="Warsztat" HorizontalAlignment="Center" FontSize="32" FontWeight="Bold" />
            <Separator Width="200" />
            <TextBlock Text="Użytkownik:" HorizontalAlignment="Left" Margin="0,0,0,-8" />
            <TextBox Watermark="Wpisz coś…" Width="200" HorizontalAlignment="Center" />
            <TextBox Watermark="Hasło" PasswordChar="●" Width="200" HorizontalAlignment="Center" />
            <Button Content="Wyślij" HorizontalAlignment="Center" Background="#2563EB" Foreground="White" />
            <CheckBox Content="Zapamiętaj mnie" HorizontalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="Wersja 1.0" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="8" Opacity="0.5" />
    </Grid>
</Window>
