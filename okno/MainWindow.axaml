<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="400"
        x:Class="okno.MainWindow"
        Title="Warsztat — Łukasz S"
        Width="640" Height="400">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
        <TextBlock Text="Warsztat" HorizontalAlignment="Center" FontSize="32" FontWeight="Bold" />
        <Separator Width="200" />
        <TextBox Watermark="Wpisz coś…" Width="200" HorizontalAlignment="Center" />
        <Button Content="Wyślij" HorizontalAlignment="Center" />
    </StackPanel>
</Window>
